# ---------------------------------------------------------------- YouTube
# Google Cloud Console > APIs & Services > Credentials > API key.
# Restrict the key to "YouTube Data API v3" only.
# Daily quota is 10,000 units; one page of 100 comments costs 1 unit.
YOUTUBE_API_KEY=

# ----------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
# Optional overrides. Defaults are the models named on the results screen.
# OPENAI_CLASSIFICATION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_SUMMARY_MODEL=gpt-4o

# --------------------------------------------------------------- Database
# Neon, connected through the Vercel Marketplace.
# Run `vercel env pull` to fill this in locally.
DATABASE_URL=
